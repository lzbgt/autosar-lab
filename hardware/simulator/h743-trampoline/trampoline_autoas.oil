/* Real Trampoline OSEK Implementation Language (OIL) task configuration.
 * The ARMv7E-M STM32F407 GOIL schema is the nearest upstream target.
 * The tracked STM32H743 Cortex-M7 board adapter replaces all F407 startup,
 * clock and peripheral code; no F407 peripheral driver is linked.
 */
OIL_VERSION = "2.5";
IMPLEMENTATION trampoline {
  TASK {
    UINT32 STACKSIZE = 1024;
  };
  ISR {
    UINT32 STACKSIZE = 256;
  };
};
CPU trampoline_autoas {
  OS config {
    STATUS = EXTENDED;
    PRETASKHOOK = FALSE;
    POSTTASKHOOK = FALSE;
    PAINT_STACK = FALSE;
    PAINT_REGISTERS = FALSE;
    BUILD = TRUE {
      TRAMPOLINE_BASE_PATH = "../../../third_party/trampoline";
      APP_SRC = "rtos_app.c";
      APP_NAME = "trampoline_autoas.elf";
      CFLAGS = "-O0";
      LDFLAGS = "-Map=trampoline_autoas.map";
      COMPILER = "arm-none-eabi-gcc";
      ASSEMBLER = "arm-none-eabi-as";
      LINKER = "arm-none-eabi-ld";
      COPIER = "arm-none-eabi-objcopy";
      SYSTEM = PYTHON;
    };
    SYSTEM_CALL = TRUE;
    MEMMAP = TRUE {
      COMPILER = gcc;
      LINKER = gnu_ld { SCRIPT = "script.ld"; };
      ASSEMBLER = gnu_as;
      MEMORY_PROTECTION = FALSE;
    };
  };
  APPMODE std {};
  TASK bsw_tick {
    PRIORITY = 1;
    AUTOSTART = FALSE;
    ACTIVATION = 1;
    SCHEDULE = FULL;
  };
  ALARM bsw_periodic {
    COUNTER = SystemCounter;
    ACTION = ACTIVATETASK { TASK = bsw_tick; };
    AUTOSTART = TRUE {
      APPMODE = std;
      ALARMTIME = 1;
      CYCLETIME = 1;
    };
  };
};
